#!/usr/bin/env bash

set -u

ROOT="${1:-.}"
ROOT="$(cd "$ROOT" 2>/dev/null && pwd)" || {
    echo "Error: directory not found: $1" >&2
    exit 1
}

command -v git >/dev/null 2>&1 || {
    echo "Error: git is required." >&2
    exit 1
}

TMP_ROOT="$(mktemp -d)"
trap 'rm -rf "$TMP_ROOT"' EXIT

is_archive() {
    case "${1,,}" in
        *.zip|*.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tbz2|*.tar.xz|*.txz)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

is_git_repo() {
    local dir="$1"

    [[ -e "$dir/.git" ]] && return 0

    # Detect bare repositories
    [[ -f "$dir/HEAD" && -f "$dir/config" ]] &&
        git -C "$dir" rev-parse --is-bare-repository 2>/dev/null |
        grep -q '^true$'
}

report_directory() {
    local dir="$1"
    local display_path="$2"
    local remote
    local url
    local found=0

    if ! is_git_repo "$dir"; then
        NOT_REPOS+=("$display_path")
        return
    fi

    while IFS= read -r remote; do
        while IFS= read -r url; do
            [[ -n "$url" ]] || continue

            if [[ "$found" -eq 0 ]]; then
                REPOS_WITH_REMOTES+=("$display_path")
                found=1
            fi

            REMOTE_LINES+=("  $remote = $url")
        done < <(git -C "$dir" remote get-url --all "$remote" 2>/dev/null)
    done < <(git -C "$dir" remote 2>/dev/null)

    if [[ "$found" -eq 0 ]]; then
        REPOS_WITHOUT_REMOTES+=("$display_path")
    fi
}

scan_archive() {
    local archive="$1"
    local display_path="$2"
    local extract_dir
    local child
    local child_name

    extract_dir="$(mktemp -d "$TMP_ROOT/archive.XXXXXX")"

    case "${archive,,}" in
        *.zip)
            command -v unzip >/dev/null 2>&1 || {
                ARCHIVE_ERRORS+=("$display_path: unzip is not installed")
                return
            }

            unzip -qq "$archive" -d "$extract_dir" 2>/dev/null || {
                ARCHIVE_ERRORS+=("$display_path: could not extract")
                return
            }
            ;;

        *.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tbz2|*.tar.xz|*.txz)
            tar -xf "$archive" -C "$extract_dir" \
                --no-same-owner --no-same-permissions 2>/dev/null || {
                ARCHIVE_ERRORS+=("$display_path: could not extract")
                return
            }
            ;;
    esac

    # Check whether the archive root itself is a Git repository.
    if is_git_repo "$extract_dir"; then
        report_directory "$extract_dir" "$display_path!/"
    fi

    # Only inspect directories immediately inside the archive.
    while IFS= read -r -d '' child; do
        child_name="$(basename "$child")"
        report_directory "$child" "$display_path!/$child_name"
    done < <(find "$extract_dir" -mindepth 1 -maxdepth 1 -type d -print0)
}

declare -a REPOS_WITH_REMOTES=()
declare -a REMOTE_LINES=()
declare -a REPOS_WITHOUT_REMOTES=()
declare -a NOT_REPOS=()
declare -a ARCHIVE_ERRORS=()

# Scan only directories immediately inside ROOT.
while IFS= read -r -d '' dir; do
    report_directory "$dir" "$dir"
done < <(find "$ROOT" -mindepth 1 -maxdepth 1 -type d -print0)

# Scan only archive files immediately inside ROOT.
while IFS= read -r -d '' archive; do
    if is_archive "$archive"; then
        scan_archive "$archive" "$archive"
    fi
done < <(find "$ROOT" -mindepth 1 -maxdepth 1 -type f -print0)

echo
echo "============================================================"
echo "GIT REPOSITORIES WITH REMOTES"
echo "============================================================"

if ((${#REPOS_WITH_REMOTES[@]} == 0)); then
    echo "None found."
else
    for repo in "${REPOS_WITH_REMOTES[@]}"; do
        echo "$repo"

        # Print matching remote lines in order.
        for remote_line in "${REMOTE_LINES[@]}"; do
            echo "$remote_line"
        done

        echo
    done
fi

echo
echo "============================================================"
echo "GIT REPOSITORIES WITHOUT A REMOTE"
echo "============================================================"

if ((${#REPOS_WITHOUT_REMOTES[@]} == 0)); then
    echo "None found."
else
    printf '%s\n' "${REPOS_WITHOUT_REMOTES[@]}"
fi

echo
echo "============================================================"
echo "DIRECTORIES THAT ARE NOT GIT REPOSITORIES"
echo "============================================================"

if ((${#NOT_REPOS[@]} == 0)); then
    echo "None found."
else
    printf '%s\n' "${NOT_REPOS[@]}"
fi

if ((${#ARCHIVE_ERRORS[@]} > 0)); then
    echo
    echo "============================================================"
    echo "ARCHIVES THAT COULD NOT BE SCANNED"
    echo "============================================================"

    printf '%s\n' "${ARCHIVE_ERRORS[@]}"
fi