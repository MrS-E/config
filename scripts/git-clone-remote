#!/bin/bash

pull_all_branches() {
    # Create local tracking branches for all remote branches
    for branch in $(git branch -r | grep -v '\->'); do
        git branch --track "${branch#*/}" "$branch" 2>/dev/null || true
    done
}

usage() {
    echo "Usage: $0 <new-git-remote-url>"
    echo "       $0 --pull-all"
}

# Check if URL parameter is provided
if [[ "${1:-}" == "--shell-integration" ]]; then
    exit 0
fi

if [[ "${1:-}" == "--pull-all" ]]; then
    if [[ $# -ne 1 ]]; then
        usage
        exit 1
    fi

    git fetch --all --prune
    pull_all_branches
    echo "All remote branches have been pulled locally"
    exit 0
fi

if [ -z "$1" ]; then
    usage
    exit 1
fi

NEW_REMOTE_URL="$1"
NEW_REMOTE_NAME="new-origin"

git fetch --prune origin
pull_all_branches

# Add new remote
git remote add "$NEW_REMOTE_NAME" "$NEW_REMOTE_URL"

# Push all branches and tags to new remote
git push --all "$NEW_REMOTE_NAME"
git push --tags "$NEW_REMOTE_NAME"

echo "All branches and tags have been pushed to $NEW_REMOTE_NAME ($NEW_REMOTE_URL)"
