{
    "mcpServers": {
        "Chrome DevTools": {
            "args": [
                "-y",
                "chrome-devtools-mcp@latest"
            ],
            "command": "npx"
        },
        "browsermcp": {
            "args": [
                "@browsermcp/mcp@latest"
            ],
            "command": "npx"
        },
        "idea": {
            "url": "http://127.0.0.1:64342/stream"
        },
        "xcode": {
            "args": [
                "mcpbridge"
            ],
            "command": "xcrun"
        }
    }
}
