{
    "mcpServers": {
        "Chrome DevTools": {
            "args": [
                "-y",
                "chrome-devtools-mcp@latest"
            ],
            "command": "npx",
            "enabled": false
        },
        "browsermcp": {
            "args": [
                "@browsermcp/mcp@latest"
            ],
            "command": "npx",
            "enabled": false
        },
        "xcode": {
            "args": [
                "mcpbridge"
            ],
            "command": "xcrun",
            "enabled": false
        }
    }
}
