{
    "mcpServers": {
        "Chrome DevTools": {
            "args": [
                "-y",
                "chrome-devtools-mcp@latest"
            ],
            "command": "npx"
        },
        "browsermcp": {
            "args": [
                "@browsermcp/mcp@latest"
            ],
            "command": "npx"
        },
        "clion": {
            "url": "http://127.0.0.1:64362/stream"
        },
        "esp-idf-eim": {
            "args": [
                "run",
                "idf.py mcp-server"
            ],
            "command": "eim",
            "env": {
                "IDF_MCP_WORKSPACE_FOLDER": "${workspaceFolder}"
            }
        },
        "espressif-component-registry": {
            "url": "https://components.espressif.com/mcp"
        },
        "espressif-docs": {
            "url": "https://mcp.espressif.com/docs"
        },
        "espressif-engineering": {
            "url": "https://ts-mcp.espressif.com/mcp"
        },
        "xcode": {
            "args": [
                "mcpbridge"
            ],
            "command": "xcrun"
        }
    }
}
