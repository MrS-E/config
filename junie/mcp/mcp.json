{
    "mcpServers": {
        "Chrome DevTools": {
            "args": [
                "-y",
                "chrome-devtools-mcp@latest"
            ],
            "command": "npx"
        },
        "browsermcp": {
            "args": [
                "@browsermcp/mcp@latest"
            ],
